{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/SymlinkRepair.hook.ts\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/HandoffReminder.hook.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/HygieneStatus.hook.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/PluginDriftCheck.hook.ts\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/conventional-commit.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/PrePushStaleSHACheck.hook.ts\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/worktree-guard.sh\"",
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/PreMergeCodexHarvest.hook.sh\"",
            "if": "Bash(gh pr merge*)"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/ntfy-awaiting-input.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/format-on-edit.sh\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\""
  }
}
