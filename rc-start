#!/usr/bin/env bash
# Start Claude Code Remote Control in a detached tmux session named "rc".
# Usage: rc-start          start if not running
#        rc-start --hold   also block forever, so the wsl.exe that launched us
#                          keeps the WSL VM alive (used by the Windows boot task)
#
# setup.sh links this into ~/.local/bin. The session starts in the folder that
# holds the dotfiles checkout (~/dev by convention), found through that link;
# RC_START_DIR overrides it.
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
# Remote Control runs claude directly, not through a login shell, so the bun
# line in ~/.bash_profile never applies to its sessions: add bun and bunx here.
if [[ -d "$HOME/.bun/bin" ]]; then
  export PATH="$HOME/.bun/bin:$PATH"
fi

# Resolve this script through its symlinks (portable: no `readlink -f`).
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  target="$(readlink "$self")"
  if [[ "$target" == /* ]]; then
    self="$target"
  else
    self="$(cd -P "$(dirname "$self")" && pwd)/$target"
  fi
done
workdir="${RC_START_DIR:-$(cd -P "$(dirname "$self")/.." && pwd)}"
# tmux falls back to $HOME when it can't enter -c's directory: refuse instead.
if [[ ! -d "$workdir" ]]; then
  echo "rc-start: working directory $workdir does not exist" >&2
  exit 1
fi
log="${XDG_STATE_HOME:-$HOME/.local/state}/rc-start.log"
mkdir -p "$(dirname "$log")"

# The rc session is rc-start's own. It counts as running only while one of
# its panes is alive: the session ends when claude does (no shell is kept
# behind it), and where remain-on-exit is on, the dead pane that stays
# behind is replaced rather than reported as running. `=rc` matches the
# name exactly; plain `rc` would also match rc-other. The exit status is
# logged; tmux gives a new session this client's PATH but, on a server that
# is already running, none of its other variables, so the log path goes in
# with -e.
rc_alive() {
  # `=rc:` is the session form: list-panes takes a window target, and a bare
  # `=rc` that names no window falls back to another session.
  tmux list-panes -s -t '=rc:' -F '#{pane_dead}' 2>/dev/null | grep -qx 0
}
if rc_alive; then
  echo "rc-start: Remote Control already running (tmux attach -t rc)"
else
  tmux kill-session -t '=rc' 2>/dev/null || true
  tmux new-session -d -s rc -c "$workdir" -e "RC_START_LOG=$log" \
    'claude remote-control --permission-mode auto; rc=$?; echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) remote-control exited ($rc)" >> "$RC_START_LOG"'
  echo "rc-start: Remote Control started in tmux session 'rc' ($workdir)"
fi

if [[ "${1:-}" == "--hold" ]]; then
  exec sleep infinity
fi
