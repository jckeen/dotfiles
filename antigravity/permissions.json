      "command(regex:(?si)(^|[\\s'\"=:]|/+)\\.(ssh|aws|gnupg|azure|kube|docker|netrc|npmrc|pypirc|git-credentials)(/+|[\\s'\"]|$))",
      "command(regex:(?si)(^|[\\s'\"=:]|/+)\\.config/+(\\./+)*(gh|gcloud)(/+|[\\s'\"]|$))",
      "command(regex:(?si)(^|[\\s'\"=:]|/+)\\.env(\\.[A-Za-z0-9_.-]+)?([\\s'\"]|$))",
      "command(regex:(?si)(^|[\\s'\"=:]|/+)id_(rsa|ed25519|ecdsa|dsa)(_sk)?(\\.pub)?([\\s'\"]|$))",
      "command(regex:(?si)(^|[\\s'\"=:]|/+)([A-Za-z0-9_.-]*(credentials|token|secret)s?\\.(json|ya?ml|toml|txt|env)|hosts\\.ya?ml|oauth_creds\\.json|google_accounts\\.json|auth\\.json)([\\s'\"]|$))",
      "command(regex:(?si)(>>?|\\btee\\b(\\s+-\\S+)*)\\s*['\"]?(~|\\$\\{?HOME\\}?|/+(\\./+)*home/+(\\./+)*[^\\s/]+|/+(\\./+)*Users/+(\\./+)*[^\\s/]+)/+(\\./+)*\\.)",
      "command(regex:(?si)(>>?|\\btee\\b(\\s+-\\S+)*)\\s*['\"]?/+(\\./+)*(etc|usr|bin|sbin|boot|root|var|opt|lib|lib64)/)",
      "command(regex:(?s)(>>?|\\btee\\b(\\s+-\\S+)*)\\s*['\"]?\\S*\\.\\./)",
      "command(regex:(?s)\\bsed\\b.*\\s(-[a-zA-Z]*i|--in-place))",
      "command(regex:(?s)\\bperl\\b.*\\s-[a-zA-Z]*i)",
      "command(regex:(?s)\\brg\\b.*\\s--pre\\b)",
      "command(regex:(?s)\\bgit(\\s+(-[A-Za-z]|--[A-Za-z-]+)(=\\S+|\\s+[^-\\s]\\S*)?)*\\s+(-c|--exec-path|--config-env)\\b)",
      "command(regex:(?s)\\bgit(\\s+(-[A-Za-z]|--[A-Za-z-]+)(=\\S+|\\s+[^-\\s]\\S*)?)*\\s+(clone|fetch|pull|ls-remote|submodule|remote)\\b.*\\s(-c|--config|--upload-pack|--exec|-u|--recurse-submodules|--rebase)\\b)",
