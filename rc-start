#!/usr/bin/env bash
# Start Claude Code Remote Control in a detached tmux session named "rc".
# Usage: rc-start          start if not running
#        rc-start --hold   also block forever, so the wsl.exe that launched us
#                          keeps the WSL VM alive (used by the Windows boot task)
#
# setup.sh links this into ~/.local/bin. The session starts in ~/dev, or in
# RC_START_DIR when that is set.
set -euo pipefail
# A CDPATH would let `cd` below resolve a relative RC_START_DIR somewhere else.
unset CDPATH

export PATH="$HOME/.local/bin:$PATH"
# Remote Control runs claude directly, not through a login shell, so the bun
# line in ~/.bash_profile never applies to its sessions: add bun and bunx here.
if [[ -d "$HOME/.bun/bin" ]]; then
  export PATH="$HOME/.bun/bin:$PATH"
fi

# The directory is entered, not tested with -d (tmux silently starts in $HOME
# when it can't enter -c's directory, which includes one that exists but isn't
# searchable), and read back from $PWD, not $(pwd), which would drop trailing
# newlines from the name.
candidate="${RC_START_DIR:-$HOME/dev}"
if ! cd -P -- "$candidate" 2>/dev/null; then
  echo "rc-start: cannot enter working directory $candidate" >&2
  exit 1
fi
workdir="$PWD"
log="${XDG_STATE_HOME:-$HOME/.local/state}/rc-start.log"
mkdir -p -- "${log%/*}"

# `=rc` matches the session name exactly; plain `rc` would also match
# rc-other. The session ends when claude does (no shell is kept behind it),
# so a later call starts it again; the exit status is logged. Its window gets
# remain-on-exit off in the same tmux command that creates it, so a config
# that turns the option on can't leave a dead pane counting as running, and
# nothing ever has to kill a session. Two calls at once: tmux refuses the
# second session name, and that call reports the first one's session.
# -c is expanded as a tmux format, so `#` is doubled; -e values are not.
# tmux gives a new session this client's PATH but, on a server that is
# already running, none of its other variables, so the log path goes in -e.
# The command is passed as separate arguments, which tmux runs directly, so
# its POSIX shell never depends on tmux's default-shell.
if tmux has-session -t '=rc' 2>/dev/null; then
  echo "rc-start: Remote Control already running (tmux attach -t rc)"
elif tmux new-session -d -s rc -c "${workdir//#/##}" -e "RC_START_LOG=$log" \
    sh -c 'claude remote-control --permission-mode auto; rc=$?; echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) remote-control exited ($rc)" >> "$RC_START_LOG"' \
    \; set-option -w -t '=rc:' remain-on-exit off 2>/dev/null; then
  echo "rc-start: Remote Control started in tmux session 'rc' ($workdir)"
elif tmux has-session -t '=rc' 2>/dev/null; then
  echo "rc-start: Remote Control already running (started by another call)"
else
  echo "rc-start: could not start tmux session 'rc'" >&2
  exit 1
fi

if [[ "${1:-}" == "--hold" ]]; then
  exec sleep infinity
fi
