{
  "handoff-context": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "~/.claude/scripts/agy-inject-handoff.sh",
        "timeout": 10
      }
    ]
  },
  "permission-classifier": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/agy-permission-classifier.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
