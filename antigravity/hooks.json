{
  "handoff-context": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "~/.claude/scripts/agy-inject-handoff.sh",
        "timeout": 10
      }
    ]
  },
  "permission-classifier": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|view_file|grep_search|find_by_name|list_dir|send_input|manage_task",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I ~/.claude/scripts/agy-permission-classifier.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
