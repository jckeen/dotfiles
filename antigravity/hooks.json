{
  "handoff-context": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "~/.claude/scripts/agy-inject-handoff.sh",
        "timeout": 10
      }
    ]
  },
  "permission-classifier": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I ~/.claude/scripts/agy-permission-classifier.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
