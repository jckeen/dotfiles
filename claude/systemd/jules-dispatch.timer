[Unit]
Description=Daily fire of jules-dispatch.service

[Timer]
# Daily at 09:00 local time — before git-hygiene.timer at 09:30, so a routine PR
# that lands during the day is already visible to the evening sweep. If the
# machine was off, run on next boot.
OnCalendar=*-*-* 09:00:00
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
